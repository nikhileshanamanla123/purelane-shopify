<section class="content-section bundle-section" id="bundles">
  <div class="page-width">
    <div class="section-heading section-heading-centered">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.body }}</p>
    </div>
    <div class="bundle-grid">
      {% for block in section.blocks %}
        <article class="bundle-card {% if forloop.index == 2 %}bundle-card-featured{% endif %}" {{ block.shopify_attributes }}>
          <span class="bundle-badge">{{ block.settings.badge }}</span>
          <div class="bundle-art bundle-art-{{ forloop.index }}">
            {% for index in (1..5) %}
              <span class="bundle-art-bottle"></span>
            {% endfor %}
          </div>
          <div class="bundle-quantity"><strong>{{ block.settings.quantity }}</strong><span>products</span></div>
          <div class="bundle-price"><strong>₹{{ block.settings.price }}</strong><s>₹{{ block.settings.compare_at_price }}</s></div>
          <p>{{ block.settings.description }}</p>
          <ul class="check-list">
            <li>Free shipping across India</li>
            <li>No code needed</li>
          </ul>
          <a href="#shop" class="button {% if forloop.index == 2 %}button-primary{% else %}button-secondary{% endif %}">{{ block.settings.button_label }} {% render 'icon-arrow' %}</a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="how-section" id="how-it-works">
  <div class="page-width">
    <div class="how-card">
      <div>
        <p class="eyebrow">Why bundles beat buying single</p>
        <h2>One flat price.<br>Less to think about.</h2>
      </div>
      <div class="how-points">
        <span><b>01</b><strong>Save up to 45%</strong><small>Versus buying separately</small></span>
        <span><b>02</b><strong>Curated by experts</strong><small>Products picked to work together</small></span>
        <span><b>03</b><strong>Free shipping always</strong><small>Included on every bundle</small></span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundles",
  "tag": "section",
  "class": "bundles-section",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Mix and match across kitchen, laundry, home and skin. One flat price, free shipping either way." }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle tier",
      "settings": [
        { "type": "text", "id": "badge", "label": "Badge", "default": "Most popular" },
        { "type": "text", "id": "quantity", "label": "Product quantity", "default": "3" },
        { "type": "text", "id": "price", "label": "Price", "default": "499" },
        { "type": "text", "id": "compare_at_price", "label": "Compare-at price", "default": "897" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Pick any three products for kitchen and laundry." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Build this box" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundles",
      "blocks": [{ "type": "bundle" }, { "type": "bundle" }, { "type": "bundle" }]
    }
  ]
}
{% endschema %}
