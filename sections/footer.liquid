<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <a href="{{ routes.root_url }}" class="brand footer-brand">
        <span class="brand-mark">{% render 'icon-leaf' %}</span>
        <span class="brand-copy">
          <strong>{{ shop.name | default: 'Purelane' }}</strong>
          <small>{{ settings.brand_tagline | default: 'Clean, simply' }}</small>
        </span>
      </a>
      <p class="footer-intro">Effective cleaning, powered by nature. Made for Indian homes since day one.</p>
    </div>
    <div class="footer-column">
      <h3>Shop</h3>
      <a href="#shop">Bestsellers</a>
      <a href="#combos">Kitchen</a>
      <a href="#combos">Laundry</a>
      <a href="#bundles">Starter kits</a>
    </div>
    <div class="footer-column">
      <h3>About</h3>
      <a href="#how-it-works">How it works</a>
      <a href="#ingredients">Ingredients</a>
      <a href="#reviews">Reviews</a>
      <a href="{{ routes.contact_url }}">Contact</a>
    </div>
    <div class="footer-column">
      <h3>Get in touch</h3>
      {% if shop.email != blank %}<a href="mailto:{{ shop.email }}">{{ shop.email }}</a>{% endif %}
      <p>Plant-based care for the whole home.</p>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    <span>Privacy · Terms · Refunds</span>
  </div>
</footer>
