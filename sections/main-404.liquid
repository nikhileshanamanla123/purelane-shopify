<section class="content-section error-section">
  <div class="page-width empty-state">
    <p class="eyebrow">404</p>
    <h1>That page could not be found.</h1>
    <p>The page may have moved, or the collection has not been created yet.</p>
    <a class="button button-primary" href="{{ routes.root_url }}">Back to Purelane</a>
  </div>
</section>

{% schema %}
{
  "name": "404 page",
  "tag": "section",
  "class": "main-404-section",
  "settings": []
}
{% endschema %}