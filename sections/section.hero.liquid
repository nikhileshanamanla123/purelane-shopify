  @media(prefers-reduced-motion:reduce){#{{ section_id }} *{scroll-behavior:auto!important;transition-duration:.01ms!important;animation-duration:.01ms!important}}
</style>

<script>
  (() => {
    const root = document.getElementById('{{ section_id }}');
    const stage = root && root.querySelector('[data-purelane-stage]');
    if (!stage) return;
    const slides = [...stage.querySelectorAll('[data-purelane-slide]')];
    const dots = [...stage.querySelectorAll('[data-purelane-dot]')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer;
    const show = (next) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
        slide.querySelectorAll('a').forEach((link) => link.tabIndex = active ? 0 : -1);
      });
      dots.forEach((dot, i) => dot.setAttribute('aria-selected', String(i === index)));
    };
    const stop = () => { window.clearInterval(timer); timer = undefined; };
    const start = () => { if (!reduce && slides.length > 1 && !timer) timer = window.setInterval(() => show(index + 1), {{ section.settings.autoplay_seconds | times: 1000 }}); };
    dots.forEach((dot, i) => dot.addEventListener('click', () => { stop(); show(i); start(); }));
    stage.addEventListener('mouseenter', stop);
    stage.addEventListener('mouseleave', start);
    stage.addEventListener('focusin', stop);
    stage.addEventListener('focusout', (event) => { if (!stage.contains(event.relatedTarget)) start(); });
    show(0);
    start();
  })();
</script>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {"type":"image_picker","id":"background_image","label":"Background image"},
    {"type":"image_picker","id":"mobile_background_image","label":"Mobile background image"},
    {"type":"color","id":"overlay_color","label":"Overlay colour","default":"#012d2a"},
    {"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":100,"step":5,"unit":"%","default":45},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Plant-based homecare"},
    {"type":"inline_richtext","id":"heading","label":"Heading","default":"Clean That <em>Lasts</em>"},
    {"type":"richtext","id":"description","label":"Description","default":"<p>Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it.</p>"},
    {"type":"text","id":"primary_label","label":"Primary button label","default":"Shop all"},
    {"type":"url","id":"primary_link","label":"Primary button link"},
    {"type":"text","id":"secondary_label","label":"Secondary button label","default":"How it works"},
    {"type":"url","id":"secondary_link","label":"Secondary button link"},
    {"type":"checkbox","id":"show_product_stage","label":"Show product stage","default":true},
    {"type":"range","id":"autoplay_seconds","label":"Slide interval","min":3,"max":12,"step":1,"unit":"s","default":4},
    {"type":"text","id":"promises_label","label":"Promises label","default":"Product promises"},
    {"type":"range","id":"content_width","label":"Copy width","min":360,"max":700,"step":10,"unit":"px","default":600},
    {"type":"range","id":"min_height","label":"Minimum height","min":70,"max":110,"step":5,"unit":"vh","default":100}
  ],
  "blocks": [
    {"type":"offer_slide","name":"Offer slide","settings":[
      {"type":"product_list","id":"products","label":"Products","limit":3},
      {"type":"text","id":"label","label":"Offer label","default":"Featured products"},
      {"type":"text","id":"badge","label":"Offer note","default":"Plant powered"}
    ]},
    {"type":"promise","name":"Promise","settings":[
      {"type":"image_picker","id":"icon","label":"Icon"},
      {"type":"text","id":"title","label":"Title","default":"Plant powered"}
    ]}
  ],
  "presets": [{"name":"Hero","blocks":[{"type":"offer_slide"},{"type":"promise"},{"type":"promise"},{"type":"promise"}]}]
}
{% endschema %}
