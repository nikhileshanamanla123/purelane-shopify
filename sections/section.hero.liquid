{%- liquid
  assign section_id = 'PurelaneHero-' | append: section.id
  assign first_slide = section.blocks | where: 'type', 'offer_slide' | first
-%}

<section
  id="{{ section_id }}"
  class="purelane-hero"
  style="
    --purelane-hero-overlay: {{ section.settings.overlay_color }};
    --purelane-hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --purelane-hero-content-width: {{ section.settings.content_width }}px;
    --purelane-hero-min-height: {{ section.settings.min_height }}svh;
  "
>
  {%- if section.settings.background_image != blank -%}
    <picture class="purelane-hero__background" aria-hidden="true">
      {%- if section.settings.mobile_background_image != blank -%}
        <source
          media="(max-width: 900px)"
          srcset="
            {{ section.settings.mobile_background_image | image_url: width: 750 }} 750w,
            {{ section.settings.mobile_background_image | image_url: width: 1100 }} 1100w
          "
        >
      {%- endif -%}
      {{
        section.settings.background_image
        | image_url: width: 2200
        | image_tag:
          widths: '750, 1100, 1500, 1800, 2200',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
      }}
    </picture>
  {%- endif -%}
  <div class="purelane-hero__overlay" aria-hidden="true"></div>

  <div class="purelane-hero__inner">
    <div class="purelane-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="purelane-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="purelane-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      <div class="purelane-hero__rule" aria-hidden="true"><span></span><span>✦</span><span></span></div>
      {%- if section.settings.description != blank -%}
        <div class="purelane-hero__description rte">{{ section.settings.description }}</div>
      {%- endif -%}
      <div class="purelane-hero__actions">
        {%- if section.settings.primary_label != blank and section.settings.primary_link != blank -%}
          <a class="purelane-hero__button purelane-hero__button--primary" href="{{ section.settings.primary_link }}">
            {{ section.settings.primary_label | escape }}
            <span aria-hidden="true">→</span>
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
          <a class="purelane-hero__button purelane-hero__button--secondary" href="{{ section.settings.secondary_link }}">
            {{ section.settings.secondary_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.show_product_stage and first_slide != blank -%}
      <div class="purelane-hero__stage" data-purelane-stage>
        <div class="purelane-hero__slides">
          {%- assign slide_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'offer_slide' -%}
              {%- assign slide_index = slide_index | plus: 1 -%}
              <article
                class="purelane-hero__slide{% if block.id == first_slide.id %} is-active{% endif %}"
                data-purelane-slide
                data-slide-index="{{ slide_index | minus: 1 }}"
                aria-hidden="{% if block.id == first_slide.id %}false{% else %}true{% endif %}"
                {{ block.shopify_attributes }}
              >
                <div class="purelane-hero__products">
                  {%- for product in block.settings.products limit: 3 -%}
                    <a class="purelane-hero__product" href="{{ product.url }}" tabindex="{% if block.id == first_slide.id %}0{% else %}-1{% endif %}">
                      {% render 'purelane-product-media', product: product, loading: 'lazy', sizes: '(min-width: 901px) 18vw, 28vw' %}
                      <span class="visually-hidden">{{ product.title }}</span>
                    </a>
                  {%- endfor -%}
                </div>
                <div class="purelane-hero__offer">
                  {%- if block.settings.label != blank -%}<span>{{ block.settings.label | escape }}</span>{%- endif -%}
                  {%- assign lead_product = block.settings.products | first -%}
                  {%- if lead_product != blank -%}
                    <strong>{{ lead_product.price | money }}</strong>
                    {%- if lead_product.compare_at_price > lead_product.price -%}
                      <s>{{ lead_product.compare_at_price | money }}</s>
                    {%- endif -%}
                  {%- endif -%}
                  {%- if block.settings.badge != blank -%}<small>{{ block.settings.badge | escape }}</small>{%- endif -%}
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="purelane-hero__dots" role="tablist" aria-label="{{ 'sections.slideshow.load_slide' | t }}">
          {%- assign dot_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'offer_slide' -%}
              <button
                type="button"
                role="tab"
                aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ dot_index | plus: 1 }}"
                aria-selected="{% if dot_index == 0 %}true{% else %}false{% endif %}"
                data-purelane-dot="{{ dot_index }}"
              ></button>
              {%- assign dot_index = dot_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- assign promise_blocks = section.blocks | where: 'type', 'promise' -%}
    {%- if promise_blocks.size > 0 -%}
      <div class="purelane-hero__promises" aria-label="{{ section.settings.promises_label | escape }}">
        {%- for block in promise_blocks -%}
          <div class="purelane-hero__promise" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon | image_url: width: 80 | image_tag: widths: '40, 80', loading: 'lazy', alt: '' }}
            {%- endif -%}
            <span>{{ block.settings.title | escape }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

