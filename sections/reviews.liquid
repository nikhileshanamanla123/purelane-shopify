<section class="content-section reviews-section" id="reviews">
  <div class="page-width">
    <div class="section-heading reviews-heading">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <div class="review-summary"><span class="stars">★★★★★</span><strong>{{ section.settings.rating }}</strong><span>{{ section.settings.review_count }}</span></div>
    </div>
  </div>
  <div class="review-rail" data-horizontal-rail>
    {% for block in section.blocks %}
      <article class="review-card" {{ block.shopify_attributes }}>
        <div class="stars">★★★★★</div>
        <blockquote>“{{ block.settings.quote }}”</blockquote>
        <div class="review-author"><span class="review-check">✓</span><strong>{{ block.settings.author }}</strong><small> · {{ block.settings.product }}</small></div>
      </article>
    {% endfor %}
  </div>
</section>

<section class="newsletter-section">
  <div class="page-width">
    {% form 'customer', class: 'newsletter-card' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div>
        <p class="eyebrow">Join the Purelane club</p>
        <h2>Get ₹100 off your first bundle.</h2>
        <p>Plus first access to new launches and restocks.</p>
      </div>
      <div class="newsletter-form">
        <label class="sr-only" for="NewsletterEmail">Email address</label>
        <input id="NewsletterEmail" type="email" name="contact[email]" placeholder="your@email.com" required>
        <button class="button button-primary" type="submit">Get my ₹100 off</button>
      </div>
      {% if form.posted_successfully? %}<p class="form-message">You’re on the list.</p>{% endif %}
      {% if form.errors %}<p class="form-message">{{ form.errors | default_errors }}</p>{% endif %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Reviews rail",
  "tag": "section",
  "class": "reviews-rail-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "That’s what they said" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real homes. Real results." },
    { "type": "text", "id": "rating", "label": "Rating", "default": "4.8" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "from 8,000+ reviews" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Review", "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better." },
        { "type": "text", "id": "author", "label": "Author", "default": "Verified buyer" },
        { "type": "text", "id": "product", "label": "Product", "default": "Laundry detergent" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews rail",
      "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }]
    }
  ]
}
{% endschema %}