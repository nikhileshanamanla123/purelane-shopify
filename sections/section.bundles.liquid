{%- liquid
  assign section_id = 'PurelaneBundles-' | append: section.id
-%}

<section id="{{ section_id }}" class="purelane-bundles sec" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad">
      <div class="panel-head" style="margin-bottom:0">
        {%- if section.settings.kicker != blank -%}
          <span class="kicker">{{ section.settings.kicker | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="lede" style="margin:14px auto 0">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="tiers">
      {%- for block in section.blocks -%}
        <article class="glass tier{% if block.settings.is_popular %} best{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.tag != blank -%}
            <span class="tag">{{ block.settings.tag | escape }}</span>
          {%- endif -%}

          {%- if block.settings.preview_image != blank -%}
            <div class="tierpix" aria-hidden="true">
              {{
                block.settings.preview_image
                | image_url: width: 300
                | image_tag: widths: '150, 300', loading: 'lazy', alt: '', class: 'tier-img'
              }}
            </div>
          {%- endif -%}

          <div class="qty">
            {{ block.settings.quantity | escape }}
            <small>{{ block.settings.quantity_label | default: 'Products' }}</small>
          </div>

          <div class="price">
            {{ block.settings.price | escape }}
            {%- if block.settings.compare_price != blank -%}
              <s>{{ block.settings.compare_price | escape }}</s>
            {%- endif -%}
          </div>

          {%- if block.settings.unit_price_note != blank -%}
            <p class="body-s" style="font-size:12px">{{ block.settings.unit_price_note | escape }}</p>
          {%- endif -%}

          {%- if block.settings.features != blank -%}
            <ul class="tier-features" role="list">
              {%- assign lines = block.settings.features | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}
                {%- assign clean_line = line | strip -%}
                {%- if clean_line != blank -%}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m5 13 4 4L19 7"/>
                    </svg>
                    <span>{{ clean_line }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <a class="btn {% if block.settings.is_popular %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_url | default: '#shop' }}">
            {{ block.settings.button_label | default: 'Build this box' }}
            {%- if block.settings.is_popular -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h13m-5-6 6 6-6 6"/>
              </svg>
            {%- endif -%}
          </a>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #{{ section_id }} {
    position: relative;
    padding: var(--sec-y, 34px) 0;
  }
  #{{ section_id }} .wrap {
    max-width: var(--maxw, 1180px);
    margin: 0 auto;
    padding: 0 18px;
  }
  #{{ section_id }} .glass {
    background: linear-gradient(158deg, rgba(255,255,255,.80), rgba(236,230,247,.56) 58%, rgba(222,212,240,.50));
    backdrop-filter: blur(24px) saturate(150%);
    -webkit-backdrop-filter: blur(24px) saturate(150%);
    border: 1px solid rgba(75,58,143,.16);
    border-radius: 26px;
    box-shadow: 0 22px 54px rgba(58,44,112,.13), inset 0 1px 0 rgba(255,255,255,.92);
    position: relative;
    overflow: hidden;
  }
  #{{ section_id }} .sec-pad {
    padding: clamp(26px, 3.4vw, 40px);
    margin-bottom: 16px;
  }
  #{{ section_id }} .panel-head {
    text-align: center;
  }
  #{{ section_id }} .kicker {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: rgba(36,26,61,.56);
  }
  #{{ section_id }} .d2 {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: clamp(30px, 4.6vw, 54px);
    line-height: .94;
    text-transform: uppercase;
    letter-spacing: -.018em;
    font-weight: 800;
    color: #17102b;
    margin: 0;
  }
  #{{ section_id }} .lede {
    font-size: clamp(15px, 1.35vw, 17.5px);
    color: rgba(36,26,61,.78);
    max-width: 44ch;
    line-height: 1.62;
  }
  #{{ section_id }} .tiers {
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) {
    #{{ section_id }} .tiers {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  #{{ section_id }} .tier {
    padding: 24px 22px;
    transition: transform .4s cubic-bezier(.2,.7,.2,1);
    display: flex;
    flex-direction: column;
  }
  #{{ section_id }} .tier:hover {
    transform: translateY(-5px);
  }
  #{{ section_id }} .tier.best {
    border-color: rgba(201,118,29,.46);
    box-shadow: 0 22px 54px rgba(58,44,112,.14), 0 0 0 1px rgba(201,118,29,.24), inset 0 1px 0 rgba(255,255,255,.92);
  }
  #{{ section_id }} .tag {
    display: inline-block;
    align-self: flex-start;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 999px;
    margin-bottom: 14px;
    background: rgba(201,118,29,.14);
    border: 1px solid rgba(201,118,29,.34);
    color: #4f7d10;
  }
  #{{ section_id }} .tierpix {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 2px;
    height: 78px;
    margin: -4px 0 16px;
    padding: 8px 6px;
    border-radius: 14px;
    background: linear-gradient(162deg, rgba(255,255,255,.54), rgba(236,230,247,.34));
    border: 1px solid rgba(75,58,143,.11);
  }
  #{{ section_id }} .tierpix img {
    height: 60px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 5px 8px rgba(0,74,66,.13));
  }
  #{{ section_id }} .qty {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 52px;
    line-height: .9;
    color: #17102b;
    letter-spacing: -.03em;
  }
  #{{ section_id }} .qty small {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: rgba(36,26,61,.56);
    display: block;
    margin-top: 6px;
  }
  #{{ section_id }} .price {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 27px;
    color: #b8701c;
    margin: 16px 0 4px;
  }
  #{{ section_id }} .price s {
    font-size: 14px;
    color: rgba(36,26,61,.56);
    font-weight: 500;
    margin-left: 8px;
  }
  #{{ section_id }} .body-s {
    color: rgba(36,26,61,.78);
    line-height: 1.6;
  }
  #{{ section_id }} .tier-features {
    list-style: none;
    margin: 16px 0 22px;
    padding: 0;
    display: grid;
    gap: 10px;
    flex: 1;
  }
  #{{ section_id }} .tier-features li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    font-size: 13px;
    color: rgba(36,26,61,.78);
    line-height: 1.4;
  }
  #{{ section_id }} .tier-features svg {
    width: 14px;
    height: 14px;
    color: #4f7d10;
    flex: 0 0 auto;
    margin-top: 3px;
  }
  #{{ section_id }} .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 44px;
    padding: 0 22px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
    transition: .35s cubic-bezier(.2,.7,.2,1);
    white-space: nowrap;
    text-decoration: none;
    width: 100%;
  }
  #{{ section_id }} .btn-primary {
    background: linear-gradient(135deg, #00706a, #004b46);
    color: #f4fdf6;
    box-shadow: 0 12px 26px rgba(0,80,74,.26), inset 0 1px 0 rgba(255,255,255,.22);
  }
  #{{ section_id }} .btn-ghost {
    background: rgba(255,255,255,.66);
    border: 1px solid rgba(75,58,143,.22);
    color: #01423b;
  }
  #{{ section_id }} .btn:hover {
    transform: translateY(-2px);
  }
  #{{ section_id }} .btn svg { width: 15px; height: 15px; }
  @media (max-width: 760px) {
    #{{ section_id }} .qty { font-size: 44px; }
  }
</style>

{% schema %}
{
  "name": "Bundles / Tiers",
  "tag": "section",
  "class": "section-bundles",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle Tier",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tier badge tag",
          "default": "Starter"
        },
        {
          "type": "image_picker",
          "id": "preview_image",
          "label": "Preview imagery"
        },
        {
          "type": "text",
          "id": "quantity",
          "label": "Quantity number",
          "default": "2"
        },
        {
          "type": "text",
          "id": "quantity_label",
          "label": "Quantity label",
          "default": "Products"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Original price",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "unit_price_note",
          "label": "Per product note",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Benefits list (one per line)",
          "default": "Pick any two products\nFree shipping across India"
        },
        {
          "type": "checkbox",
          "id": "is_popular",
          "label": "Highlight as most popular",
          "default": false
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "CTA destination"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Build this box"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundles / Tiers",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tag": "Starter",
            "quantity": "2",
            "price": "₹349",
            "compare_price": "₹598",
            "unit_price_note": "Flat ₹174 per product",
            "features": "Pick any two products\nFree shipping across India",
            "is_popular": false
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Most popular",
            "quantity": "3",
            "price": "₹499",
            "compare_price": "₹897",
            "unit_price_note": "Flat ₹166 per product",
            "features": "Pick any three products\nCovers kitchen and laundry\nFree shipping across India",
            "is_popular": true
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Whole home",
            "quantity": "5",
            "price": "₹799",
            "compare_price": "₹1,495",
            "unit_price_note": "Flat ₹160 per product",
            "features": "Pick any five products\nEvery room in one order\nFree shipping across India",
            "is_popular": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
