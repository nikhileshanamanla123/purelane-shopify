<section class="content-section product-section" id="shop">
  <div class="page-width">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.collection != blank %}
        <a class="text-link" href="{{ section.settings.collection.url }}">View all {% render 'icon-arrow' %}</a>
      {% endif %}
    </div>
    <div class="product-grid">
      {% assign collection = section.settings.collection %}
      {% if collection != blank and collection.products_count > 0 %}
        {% for product in collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product, section_id: section.id %}
        {% endfor %}
      {% else %}
        {% for index in (1..4) %}
          <article class="product-card product-card-fallback">
            <div class="product-media fallback-media fallback-{{ index }}">
              <span class="product-pill">{% if index == 1 %}Best seller{% elsif index == 2 %}Top rated{% else %}Purelane{% endif %}</span>
              <span class="fallback-bottle"></span>
            </div>
            <h3>{% case index %}{% when 1 %}Tap cleaner &amp; limescale remover{% when 2 %}Kitchen cleaner, foaming{% when 3 %}Laundry detergent{% else %}A very long Purelane product title that wraps beautifully{% endcase %}</h3>
            <p class="product-meta">Add products in the selected collection to load real Shopify data.</p>
            <div class="product-price"><strong>₹200</strong><s>₹299</s><em>33% off</em></div>
            <a class="button button-secondary button-small" href="{{ routes.all_products_collection_url }}">View products</a>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

<section class="ingredient-band" id="ingredients">
  <div class="page-width ingredient-grid">
    <div>
      <p class="eyebrow">Sourced from nature</p>
      <h2>Ingredients you can recognize.</h2>
    </div>
    <div class="ingredient-list">
      <span><b>01</b> Coconut cleansers</span>
      <span><b>02</b> Orange peel</span>
      <span><b>03</b> Soap nut</span>
      <span><b>04</b> Neem</span>
      <span><b>05</b> Lemongrass</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bestsellers / product grid",
  "tag": "section",
  "class": "product-grid-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "collection", "id": "collection", "label": "Product collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Bestsellers / product grid" }]
}
{% endschema %}
