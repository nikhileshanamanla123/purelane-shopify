{%- liquid
  assign section_id = 'PurelaneCombos-' | append: section.id
-%}

<section id="{{ section_id }}" class="purelane-combos sec" data-scene="3">
  <div class="wrap">
    <div class="panel-head">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="rule" aria-hidden="true">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>
      {%- if section.settings.subheading != blank -%}
        <p class="lede" style="margin:14px auto 0">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="comborail" role="region" aria-label="Best selling combo bundles">
      {%- for block in section.blocks -%}
        <article class="glass combo{% if block.settings.is_featured %} hero-combo{% endif %}" {{ block.shopify_attributes }}>
          <div class="tray">
            {%- if block.settings.savings_text != blank -%}
              <span class="save">{{ block.settings.savings_text | escape }}</span>
            {%- endif -%}
            {%- if block.settings.flag_text != blank -%}
              <span class="flag">{{ block.settings.flag_text | escape }}</span>
            {%- endif -%}

            <div class="stack" aria-label="Included products in combo">
              {%- if block.settings.products != blank -%}
                {%- for item in block.settings.products limit: 3 -%}
                  {%- unless forloop.first -%}
                    <span class="plus" aria-hidden="true">+</span>
                  {%- endunless -%}
                  <span class="it">
                    {%- if item.featured_image != blank -%}
                      {{
                        item.featured_image
                        | image_url: width: 200
                        | image_tag: widths: '100, 200', loading: 'lazy', alt: item.title, class: 'combo-prod-img'
                      }}
                    {%- else -%}
                      <span class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/></svg></span>
                    {%- endif -%}
                    <span>{{ item.title | truncate: 22 }}</span>
                  </span>
                {%- endfor -%}
              {%- else -%}
                {%- comment -%} Fallback placeholder items {%- endcomment -%}
                <span class="it"><span class="tile">1</span><span>Kitchen Clean</span></span>
                <span class="plus" aria-hidden="true">+</span>
                <span class="it"><span class="tile">2</span><span>Dishwash Gel</span></span>
                <span class="plus" aria-hidden="true">+</span>
                <span class="it"><span class="tile">3</span><span>Tap Cleaner</span></span>
              {%- endif -%}
            </div>
          </div>

          <div class="body">
            <h3>{{ block.settings.title | escape }}</h3>
            {%- if block.settings.item_count != blank -%}
              <div class="cnt">{{ block.settings.item_count | escape }}</div>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="inc">{{ block.settings.description | escape }}</p>
            {%- endif -%}

            <div class="prow">
              <strong>{{ block.settings.price | escape }}</strong>
              {%- if block.settings.compare_price != blank -%}
                <s>{{ block.settings.compare_price | escape }}</s>
              {%- endif -%}
              {%- if block.settings.discount_pill != blank -%}
                <em>{{ block.settings.discount_pill | escape }}</em>
              {%- endif -%}
            </div>

            <div class="fine">Inclusive of all taxes &middot; COD available</div>

            <a class="btn {% if block.settings.is_featured %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_url | default: '#bundles' }}">
              {{ block.settings.button_label | default: 'Shop bundle' }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h13m-5-6 6 6-6 6"/>
              </svg>
            </a>
          </div>
        </article>
      {%- endfor -%}
    </div>

    <div class="swipecue" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h13m-5-6 6 6-6 6"/>
      </svg>
      Swipe for more combos
    </div>
    {%- if section.settings.note != blank -%}
      <p class="railnote">{{ section.settings.note | escape }}</p>
    {%- endif -%}
  </div>
</section>

<style>
  #{{ section_id }} {
    position: relative;
    padding: var(--sec-y, 34px) 0;
  }
  #{{ section_id }} .wrap {
    max-width: var(--maxw, 1180px);
    margin: 0 auto;
    padding: 0 18px;
  }
  #{{ section_id }} .panel-head {
    text-align: center;
    margin-bottom: 26px;
  }
  #{{ section_id }} .kicker {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: rgba(36,26,61,.56);
  }
  #{{ section_id }} .d2 {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: clamp(30px, 4.6vw, 54px);
    line-height: .94;
    text-transform: uppercase;
    letter-spacing: -.018em;
    font-weight: 800;
    color: #17102b;
    margin: 0;
  }
  #{{ section_id }} .rule {
    display: flex;
    align-items: center;
    gap: 13px;
    margin: 14px auto 0;
    justify-content: center;
    max-width: 240px;
    color: #b8701c;
  }
  #{{ section_id }} .rule i {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, rgba(75,58,143,.34), transparent);
  }
  #{{ section_id }} .rule i:first-child {
    background: linear-gradient(90deg, transparent, rgba(75,58,143,.34));
  }
  #{{ section_id }} .rule svg { width: 16px; height: 16px; flex: 0 0 auto; }
  #{{ section_id }} .lede {
    font-size: clamp(15px, 1.35vw, 17.5px);
    color: rgba(36,26,61,.78);
    max-width: 44ch;
    line-height: 1.62;
  }
  #{{ section_id }} .comborail {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    margin: 0 -18px;
    padding: 10px 18px 20px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  #{{ section_id }} .comborail::-webkit-scrollbar { display: none; }
  #{{ section_id }} .combo {
    flex: 0 0 302px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    padding: 0;
    border-radius: 26px;
    background: linear-gradient(158deg, rgba(255,255,255,.80), rgba(236,230,247,.56) 58%, rgba(222,212,240,.50));
    backdrop-filter: blur(24px) saturate(150%);
    -webkit-backdrop-filter: blur(24px) saturate(150%);
    border: 1px solid rgba(75,58,143,.16);
    box-shadow: 0 22px 54px rgba(58,44,112,.13), inset 0 1px 0 rgba(255,255,255,.92);
    transition: transform .4s cubic-bezier(.2,.7,.2,1);
    overflow: hidden;
  }
  #{{ section_id }} .combo:hover { transform: translateY(-5px); }
  #{{ section_id }} .combo.hero-combo {
    border-color: rgba(201,118,29,.46);
    box-shadow: 0 22px 54px rgba(58,44,112,.14), 0 0 0 1px rgba(201,118,29,.24), inset 0 1px 0 rgba(255,255,255,.92);
  }
  #{{ section_id }} .tray {
    padding: 16px 14px 14px;
    border-bottom: 1px solid rgba(75,58,143,.12);
    position: relative;
    background: linear-gradient(162deg, rgba(255,255,255,.56), rgba(236,230,247,.34));
  }
  #{{ section_id }} .save {
    display: inline-block;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 999px;
    background: rgba(255,255,255,.84);
    border: 1px solid rgba(201,118,29,.34);
    color: #4f7d10;
    margin-bottom: 13px;
  }
  #{{ section_id }} .flag {
    position: absolute;
    top: 14px;
    right: 14px;
    font-size: 8.6px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 999px;
    background: linear-gradient(135deg, #00706a, #004b46);
    color: #f4fdf6;
  }
  #{{ section_id }} .stack {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    min-height: 100px;
  }
  #{{ section_id }} .stack .it {
    flex: 1 1 0;
    min-width: 0;
    text-align: center;
  }
  #{{ section_id }} .stack .it img {
    height: 70px;
    width: auto;
    max-width: 100%;
    margin: 0 auto 8px;
    object-fit: contain;
    filter: drop-shadow(0 5px 8px rgba(0,74,66,.13));
  }
  #{{ section_id }} .stack .it .tile {
    height: 66px;
    width: 44px;
    margin: 0 auto 8px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: rgba(255,255,255,.5);
    border: 1px dashed rgba(75,58,143,.26);
    color: #4f7d10;
    font-weight: 700;
  }
  #{{ section_id }} .stack .it span {
    display: block;
    font-size: 8.6px;
    line-height: 1.32;
    color: rgba(36,26,61,.78);
    font-weight: 600;
  }
  #{{ section_id }} .stack .plus {
    flex: 0 0 9px;
    color: #b8701c;
    font-weight: 800;
    font-size: 14px;
    padding-bottom: 30px;
    text-align: center;
  }
  #{{ section_id }} .combo .body {
    padding: 16px 18px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  #{{ section_id }} .combo .body h3 {
    font-family: 'Outfit', sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -.005em;
    line-height: 1.1;
    color: #17102b;
    margin: 0;
  }
  #{{ section_id }} .cnt {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgba(36,26,61,.56);
    margin-top: 6px;
  }
  #{{ section_id }} .inc {
    font-size: 12.4px;
    color: rgba(36,26,61,.78);
    line-height: 1.55;
    margin: 11px 0 14px;
    flex: 1;
  }
  #{{ section_id }} .prow {
    display: flex;
    align-items: baseline;
    gap: 9px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }
  #{{ section_id }} .prow strong {
    font-family: 'Outfit', sans-serif;
    font-size: 25px;
    font-weight: 800;
    color: #17102b;
    letter-spacing: -.02em;
  }
  #{{ section_id }} .prow s {
    font-size: 13px;
    color: rgba(36,26,61,.56);
  }
  #{{ section_id }} .prow em {
    font-style: normal;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: 999px;
    background: rgba(201,118,29,.14);
    border: 1px solid rgba(201,118,29,.34);
    color: #4f7d10;
  }
  #{{ section_id }} .fine {
    font-size: 10.4px;
    color: rgba(36,26,61,.56);
    margin-bottom: 14px;
  }
  #{{ section_id }} .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
    transition: .35s cubic-bezier(.2,.7,.2,1);
    white-space: nowrap;
    text-decoration: none;
  }
  #{{ section_id }} .btn-primary {
    background: linear-gradient(135deg, #00706a, #004b46);
    color: #f4fdf6;
    box-shadow: 0 12px 26px rgba(0,80,74,.26), inset 0 1px 0 rgba(255,255,255,.22);
  }
  #{{ section_id }} .btn-ghost {
    background: rgba(255,255,255,.66);
    border: 1px solid rgba(75,58,143,.22);
    color: #01423b;
  }
  #{{ section_id }} .btn:hover {
    transform: translateY(-2px);
  }
  #{{ section_id }} .btn svg { width: 15px; height: 15px; }
  #{{ section_id }} .railnote {
    text-align: center;
    font-size: 12px;
    color: rgba(36,26,61,.56);
    margin-top: 14px;
    max-width: 62ch;
    margin-left: auto;
    margin-right: auto;
  }
  #{{ section_id }} .swipecue {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgba(36,26,61,.56);
    margin-top: 6px;
  }
  #{{ section_id }} .swipecue svg { width: 14px; height: 14px; color: #b8701c; }
  @media (max-width: 760px) {
    #{{ section_id }} .combo { flex: 0 0 270px; }
    #{{ section_id }} .swipecue { display: flex; }
  }
</style>

{% schema %}
{
  "name": "Best-Selling Combos",
  "tag": "section",
  "class": "section-combos",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Footnote",
      "default": "Tapping 'Shop bundle' opens the bundle picker with these products already added. You can still swap anything before you pay."
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo box",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Combo title",
          "default": "Kitchen essentials"
        },
        {
          "type": "text",
          "id": "item_count",
          "label": "Item count label",
          "default": "3 products"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Included products summary",
          "default": "Includes: Foaming Kitchen Cleaner, Dishwash Gel & Tap Cleaner. Everything for a sparkling kitchen."
        },
        {
          "type": "text",
          "id": "savings_text",
          "label": "Savings pill",
          "default": "You save ₹398"
        },
        {
          "type": "text",
          "id": "flag_text",
          "label": "Highlight flag",
          "default": "Most popular"
        },
        {
          "type": "checkbox",
          "id": "is_featured",
          "label": "Feature as best value",
          "default": false
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products in this combo",
          "limit": 3
        },
        {
          "type": "text",
          "id": "price",
          "label": "Bundle price",
          "default": "₹499"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Original total",
          "default": "₹897"
        },
        {
          "type": "text",
          "id": "discount_pill",
          "label": "Discount badge",
          "default": "Save ₹398"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button destination"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop bundle"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best-Selling Combos",
      "blocks": [
        {
          "type": "combo",
          "settings": {
            "title": "Kitchen essentials",
            "item_count": "3 products",
            "savings_text": "You save ₹398",
            "flag_text": "Most popular",
            "price": "₹499",
            "compare_price": "₹897",
            "discount_pill": "Save ₹398"
          }
        },
        {
          "type": "combo",
          "settings": {
            "title": "Complete home bundle",
            "item_count": "5 products",
            "savings_text": "Biggest saving",
            "flag_text": "Best value",
            "is_featured": true,
            "price": "₹799",
            "compare_price": "₹1,495",
            "discount_pill": "Save ₹696"
          }
        },
        {
          "type": "combo",
          "settings": {
            "title": "Bathroom deep clean",
            "item_count": "3 products",
            "savings_text": "You save ₹398",
            "price": "₹499",
            "compare_price": "₹897",
            "discount_pill": "Save ₹398"
          }
        }
      ]
    }
  ]
}
{% endschema %}
