{%- liquid
  assign section_id = 'PurelaneReviews-' | append: section.id
-%}

<section id="{{ section_id }}" class="purelane-reviews sec revband" data-scene="1">
  <div class="wrap">
    <div class="revhead">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      {%- if section.settings.rating_aggregate != blank -%}
        <span class="agg">
          <span class="st" aria-hidden="true">★★★★★</span>
          <b>{{ section.settings.rating_score | default: '4.8' }}</b> {{ section.settings.rating_aggregate | escape }}
        </span>
      {%- endif -%}
      {%- if section.settings.social_proof != blank -%}
        <span class="agg">{{ section.settings.social_proof }}</span>
      {%- endif -%}
    </div>
  </div>

  <div class="revrail" role="region" aria-label="Customer testimonial reviews marquee">
    <div class="revtrack">
      {%- comment -%} Render blocks twice for seamless infinite CSS marquee {%- endcomment -%}
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          <article class="glass-2 rcard" {% if i == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
            <div class="st" aria-label="{{ block.settings.stars | default: 5 }} out of 5 stars">
              {%- assign stars_count = block.settings.stars | default: 5 -%}
              {%- for s in (1..stars_count) -%}★{%- endfor -%}
            </div>
            <h5>{{ block.settings.title | escape }}</h5>
            <p>{{ block.settings.body | escape }}</p>
            <div class="who">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m5 13 4 4L19 7"/>
              </svg>
              <b>{{ block.settings.author | escape }}</b>
              {%- if block.settings.product_tag != blank -%}
                <span>&middot; {{ block.settings.product_tag | escape }}</span>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #{{ section_id }} {
    position: relative;
    padding: var(--sec-y, 34px) 0;
    overflow: hidden;
  }
  #{{ section_id }} .wrap {
    max-width: var(--maxw, 1180px);
    margin: 0 auto;
    padding: 0 18px;
  }
  #{{ section_id }} .revhead {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px 22px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  #{{ section_id }} .kicker {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: rgba(36,26,61,.56);
  }
  #{{ section_id }} .agg {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(36,26,61,.78);
  }
  #{{ section_id }} .agg b {
    font-family: 'Outfit', sans-serif;
    font-size: 16px;
    color: #b8701c;
    letter-spacing: 0;
  }
  #{{ section_id }} .st {
    color: #7a9c1e;
    font-size: 13px;
    letter-spacing: .18em;
  }
  #{{ section_id }} .revrail {
    overflow: hidden;
    position: relative;
    padding: 10px 0;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  #{{ section_id }} .revtrack {
    display: flex;
    gap: 16px;
    width: max-content;
    animation: purelane-marquee {{ section.settings.speed | default: 45 }}s linear infinite;
  }
  #{{ section_id }} .revrail:hover .revtrack,
  #{{ section_id }} .revrail:focus-within .revtrack {
    animation-play-state: paused;
  }
  @keyframes purelane-marquee {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }
  #{{ section_id }} .glass-2 {
    background: linear-gradient(158deg, rgba(255,255,255,.66), rgba(236,230,247,.44));
    backdrop-filter: blur(18px) saturate(135%);
    -webkit-backdrop-filter: blur(18px) saturate(135%);
    border: 1px solid rgba(75,58,143,.13);
    border-radius: 20px;
    box-shadow: 0 16px 38px rgba(58,44,112,.10), inset 0 1px 0 rgba(255,255,255,.86);
  }
  #{{ section_id }} .rcard {
    flex: 0 0 auto;
    width: 290px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    transition: transform .3s ease;
  }
  #{{ section_id }} .rcard:hover {
    transform: translateY(-3px);
  }
  #{{ section_id }} .rcard .st {
    margin-bottom: 8px;
    font-size: 11px;
  }
  #{{ section_id }} .rcard h5 {
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: #17102b;
    margin: 0 0 8px;
  }
  #{{ section_id }} .rcard p {
    font-size: 12.8px;
    color: rgba(36,26,61,.78);
    line-height: 1.55;
    margin: 0 0 14px;
    flex: 1;
  }
  #{{ section_id }} .rcard .who {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgba(36,26,61,.56);
  }
  #{{ section_id }} .rcard .who b {
    color: #01423b;
    font-weight: 700;
  }
  #{{ section_id }} .rcard .who svg {
    width: 13px;
    height: 13px;
    color: #4f7d10;
    flex: 0 0 auto;
  }
  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .revtrack {
      animation: none;
      overflow-x: auto;
      max-width: 100%;
      scroll-snap-type: x mandatory;
      padding-bottom: 12px;
    }
    #{{ section_id }} .rcard {
      scroll-snap-align: start;
    }
  }
</style>

{% schema %}
{
  "name": "Reviews Marquee Rail",
  "tag": "section",
  "class": "section-reviews",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating score",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_aggregate",
      "label": "Review aggregate note",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "inline_richtext",
      "id": "social_proof",
      "label": "Social proof text",
      "default": "Loved by <b>12 lakh+</b> homes"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Marquee cycle duration (seconds)",
      "min": 20,
      "max": 90,
      "step": 5,
      "default": 45
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Star rating",
          "min": 3,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review headline",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review quote",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_tag",
          "label": "Purchased product note",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Marquee Rail",
      "blocks": [
        {
