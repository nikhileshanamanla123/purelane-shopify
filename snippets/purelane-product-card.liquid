{%- comment -%}
  Renders a Purelane product card.
  Accepts:
  - product: {Object} Shopify Product object (required)
  - show_rating: {Boolean} Whether to show ratings (optional, default: true)
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign is_available = current_variant.available
  assign has_compare_price = false
  if current_variant.compare_at_price > current_variant.price
    assign has_compare_price = true
    assign savings_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif
-%}

<article class="glass card{% unless is_available %} is-sold-out{% endunless %}" data-product-id="{{ product.id }}">
  <div class="shot">
    {%- if is_available == false -%}
      <span class="pill pill--sold-out">Sold out</span>
    {%- elsif has_compare_price -%}
      <span class="pill">{{ savings_percent }}% off</span>
    {%- elsif product.tags contains 'Bestseller' -%}
      <span class="pill">Bestseller</span>
    {%- else -%}
      <span class="pill">Purelane</span>
    {%- endif -%}

    <a href="{{ product.url }}" class="shot-link" aria-label="{{ product.title | escape }}">
      {%- if product.featured_image != blank -%}
        {{
          product.featured_image
          | image_url: width: 450
          | image_tag:
            widths: '180, 260, 360, 450',
            sizes: '(min-width: 860px) 22vw, 44vw',
            loading: 'lazy',
            alt: product.featured_image.alt | default: product.title,
            class: 'product-img'
        }}
      {%- else -%}
        <div class="purelane-placeholder-box" role="img" aria-label="{{ product.title | escape }} (Image unavailable)">
          {{ 'product-1' | placeholder_svg_tag: 'purelane-placeholder-svg' }}
        </div>
      {%- endif -%}
    </a>
  </div>

  <h4 class="product-card-title">
    <a href="{{ product.url }}">{{ product.title | escape }}</a>
  </h4>

  {%- if show_rating != false -%}
    <div class="rate" aria-label="4.8 out of 5 stars">
      <b>★ 4.8</b> · 200+ reviews
    </div>
  {%- endif -%}

  <div class="pr">
    <strong>{{ current_variant.price | money }}</strong>
    {%- if has_compare_price -%}
      <s>{{ current_variant.compare_at_price | money }}</s>
      <em>{{ savings_percent }}% off</em>
    {%- endif -%}
  </div>

  <form method="post" action="/cart/add" class="card-form">
    <input type="hidden" name="id" value="{{ current_variant.id }}">
    {%- if is_available -%}
      <button type="submit" class="btn btn-ghost btn-sm" aria-label="Add {{ product.title | escape }} to cart">
        Add to cart
      </button>
    {%- else -%}
      <button type="button" class="btn btn-ghost btn-sm" disabled aria-disabled="true">
        Sold out
      </button>
    {%- endif -%}
  </form>
</article>
