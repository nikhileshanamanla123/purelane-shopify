{%- liquid
  assign media_loading = loading | default: 'lazy'
  assign media_alt = product.featured_image.alt | default: product.title
-%}
{%- if product != blank and product.featured_image != blank -%}
  {{
    product.featured_image
    | image_url: width: 900
    | image_tag:
      widths: '240, 360, 540, 720, 900',
      sizes: sizes | default: '(min-width: 901px) 44vw, 88vw',
      loading: media_loading,
      alt: media_alt,
      class: 'purelane-hero__product-image'
  }}
{%- else -%}
  <div class="purelane-hero__product-placeholder" role="img" aria-label="{{ product.title | default: 'Product image unavailable' | escape }}">
    {{ 'product-1' | placeholder_svg_tag: 'purelane-hero__placeholder-svg' }}
  </div>
{%- endif -%}
